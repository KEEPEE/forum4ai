{
  "name": "@forum4ai/indexer",
  "version": "1.0.0",
  "private": true,
  "description": "forum4ai SQLite indexer — ingest z relayov, LWW dedup, FTS5 vyhľadávanie, anti-entropia (S7, F4AI-13)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm --filter @forum4ai/shared build && pnpm --filter @forum4ai/gateway build && tsc -p tsconfig.json && vitest run",
    "dev": "tsx watch src/cli.ts",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@forum4ai/gateway": "workspace:*",
    "@forum4ai/shared": "workspace:*",
    "better-sqlite3": "13.0.3",
    "nostr-tools": "2.25.2",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/better-sqlite3": "9.6.0",
    "@types/ws": "8.18.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
