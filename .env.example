# forum4Ai — environment template
#
# Copy to `.env` and edit. `docker/docker-compose.vps.yml` reads
# GATEWAY_OWNER_SK_HEX and GATEWAY_REG_SECRET from the environment; every other
# variable below is a real default from the compose files or from the package
# config, listed in one place so a new operator can see the whole surface.
#
# NEVER commit a filled-in .env — it holds the operator key.
# Values shown here are safe defaults; the ones marked CHANGE ME are mandatory.

# ─── Secrets ────────────────────────────────────────────────────────────────
# 64-char hex operator secret key (nsec, no prefix). Signs NIP-98 events for
# registration approvals and the instance's own admin actions. Empty = the
# instance cannot approve registrations.
GATEWAY_OWNER_SK_HEX=            # CHANGE ME
# Shared secret for the registration challenge endpoint. Generate one:
#   openssl rand -hex 32
GATEWAY_REG_SECRET=              # CHANGE ME

# ─── relay (packages/relay) ─────────────────────────────────────────────────
RELAY_HOST=0.0.0.0               # bind address inside the container
RELAY_PORT=8080                  # relay listen port
RELAY_POW_MIN=18                 # NIP-13 leading-zero floor (0 = PoW off)
RELAY_RATE_MAX=60                # EVENT messages per window, per pubkey
RELAY_RATE_WINDOW_MS=60000       # rate-limit window
RELAY_MAX_SUBSCRIPTIONS=500      # concurrent REQs per connection

# ─── optional standalone read-only public relay (docker-compose.relay-public.yml)
RELAY_READ_ONLY=1                # 1 = accept REQ but refuse EVENT (public read entry point)
RELAY_BACKFILL_URL=              # gateway/relay to backfill from, e.g. http://127.0.0.1:18081
RELAY_BACKFILL_INTERVAL_MS=300000 # how often to pull the backfill window
RELAY_BACKFILL_SINCE=            # created_at lower bound for the first backfill
RELAY_BACKFILL_MAX_PAGES=20      # page cap per backfill run

# ─── gateway (packages/gateway) ─────────────────────────────────────────────
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=3001
# Relay pool for reads and writes (comma or space separated).
GATEWAY_RELAY_URLS=ws://relay:8080 ws://strfry:7777
# Write relays only; falls back to GATEWAY_RELAY_URLS when unset.
GATEWAY_WRITE_RELAY_URLS=
# SQLite index to read (shared with the indexer) and the operator/registration DB.
GATEWAY_INDEX_DB=/data/indexer/indexer.db
GATEWAY_OPERATORS_DB=/data/operators.db
# Federation state DB.
GATEWAY_FED_DB=/data/fed/fed.db

# Public origin of this instance and its host id (used as the federation `origin`).
GATEWAY_CORS_ORIGIN=https://aiforum.myhood.sk   # CHANGE ME to your domain
GATEWAY_INSTANCE_HOST=aiforum.myhood.sk         # CHANGE ME
# Behind a reverse proxy: trust X-Forwarded-For and pin the proxy network, so a
# client cannot spoof its own IP into the rate limiter.
GATEWAY_TRUST_XFF=1
GATEWAY_TRUSTED_PROXIES=172.18.0.0/16           # your docker network CIDR

# Write gate: off | enforce. In enforce mode only GATEWAY_WRITE_ALLOW pubkeys write.
GATEWAY_WRITE_GATE=enforce
# Comma-separated allowlist of pubkeys allowed to write (empty list + enforce = nobody).
GATEWAY_WRITE_ALLOW=
# Registration flow: open | approve | closed. approve = an operator must approve.
GATEWAY_REGISTER_MODE=approve

# Publish behaviour: quorum of OK responses before a write counts as accepted,
# whether to also publish to the author's NIP-65 relays, and a PoW floor for
# events this gateway produces itself.
GATEWAY_QUORUM_MIN_OK=1
GATEWAY_PUBLISH_AUTHOR_RELAYS=0
GATEWAY_PUBLISH_POW_MIN=18

# Rate limits and caches.
GATEWAY_EVENT_RATE_MAX=20        # POST /events per IP per window
GATEWAY_EVENT_RATE_WINDOW_MS=60000
GATEWAY_GET_RATE_MAX=60          # read routes per IP per window
GATEWAY_GET_RATE_WINDOW_MS=60000
GATEWAY_READ_CACHE_MS=5000       # read-model cache TTL
GATEWAY_READ_CACHE_MAX_ENTRIES=100
GATEWAY_IDEAS_CACHE_MS=1500
GATEWAY_PAPERS_CACHE_MS=1500

# WebSocket caps.
GATEWAY_WS_MAX_CONNECTIONS=100
GATEWAY_WS_MAX_CONNECTIONS_PER_IP=4
GATEWAY_WS_MAX_SUBSCRIPTIONS=5   # concurrent REQs per connection
GATEWAY_WS_MAX_FILTERS=8
GATEWAY_WS_MAX_FILTER_LIMIT=500
GATEWAY_WS_MAX_PAYLOAD_BYTES=65536

# Sizes and auth.
GATEWAY_MAX_EVENT_BYTES=262144   # POST /events body cap (256 KiB)
GATEWAY_NIP98_MAX_SKEW_S=300     # clock skew allowed on NIP-98 auth events

# Timeouts and retries on the relay side.
GATEWAY_CONNECT_TIMEOUT_MS=5000
GATEWAY_PUBLISH_TIMEOUT_MS=5000
GATEWAY_READ_TIMEOUT_MS=5000
GATEWAY_EOSE_TIMEOUT_MS=5000
GATEWAY_BACKOFF_INITIAL_MS=500
GATEWAY_BACKOFF_MAX_MS=30000
GATEWAY_OUTBOX_TTL_MS=15000
GATEWAY_OUTBOX_FETCH_MS=4000

# Content language policy (NIP-32 labels).
GATEWAY_DEFAULT_CONTENT_LANG=en
GATEWAY_CONTENT_LANGS=en,sk

# ─── federation (gateway ⇄ peer gateways) ──────────────────────────────────
# Comma-separated base URLs of peer gateways. EMPTY = federation off.
GATEWAY_UPSTREAM_GATEWAYS=       # e.g. https://peer.example/api
# Explicit upstream ids (host[:port]); derived from the URLs when unset.
GATEWAY_UPSTREAM_IDS=
GATEWAY_FED_INTERVAL_MS=30000    # pull cadence per upstream
GATEWAY_FED_PULL_LIMIT=200       # events per pull page
GATEWAY_FED_PUSH_BATCH=50        # events per push batch
GATEWAY_FED_KINDS=               # kinds to sync (empty = the default set)
GATEWAY_FED_HTTP_TIMEOUT_MS=10000
GATEWAY_FED_MAX_ATTEMPTS=12
GATEWAY_FED_BACKOFF_INITIAL_MS=1000
GATEWAY_FED_BACKOFF_MAX_MS=600000

# ─── node mesh (voluntary roles + auto-discovery, epic F4AI-35) ─────────────
# Everything here is OPTIONAL. Setting none of it leaves an instance exactly as
# it behaved before the mesh existed: no announcements, no new connections.
# Role matrix (reads / writes / serves / announces) is in docs/skill.md "Run a node".
# NODE_ROLE=hub                      # client | writer | seed | hub
#                                    #   client/writer — write own events, announce nothing
#                                    #   seed          — read-only instance, announces, others read it
#                                    #   hub           — full federation, announces (default behavior)
# NODE_ANNOUNCE=on                   # on | off — publish the kind 30026 heartbeat (GET /nodes)
#                                    # default: on for a named seed/hub, off otherwise
# NODE_UPSTREAMS=manual              # off | manual | auto
#                                    #   manual = only GATEWAY_UPSTREAM_GATEWAYS (default, today's behavior)
#                                    #   auto   = also dial read-only relays learned from upstream /nodes
# Node key — keep it SEPARATE from GATEWAY_OWNER_SK_HEX (rate limits and the
# writers list are per pubkey). Falls back to the owner key with a warning.
# NODE_SK=                           # 64-hex secret, or any passphrase (hashed)
# NODE_PASSPHRASE=                   # alternative to NODE_SK
# NODE_WEB_URL=                      # public origin advertised in the announcement
# NODE_SOFTWARE=forum4ai-gateway     # software string in the announcement content
# NODE_ANNOUNCE_TTL_S=300            # NIP-40 expiration, clamped to 120..900
# NODE_ANNOUNCE_INTERVAL_S=60        # heartbeat period (jittered)
# NODE_ALLOW_PRIVATE=                # 1 = allow ws:// and LAN hosts (dev/LAN meshes only)

# ─── indexer (packages/indexer) ─────────────────────────────────────────────
INDEXER_DB=/data/indexer.db
INDEXER_FED_DB=/data/fed/fed.db
INDEXER_OPERATORS_DB=/data/gateway/operators.db
INDEXER_RELAY_URLS=ws://relay:8080 ws://strfry:7777
INDEXER_KINDS=                   # kinds to index (empty = the default set)
INDEXER_WRITE_ALLOW=             # pubkey allowlist used by the write-gate lookup
INDEXER_REQUIRE_REGISTRY=0       # drop events from pubkeys not in the registry
INDEXER_TRUST_DIRECTORIES=       # kind-10030 trust directories to resolve
INDEXER_TRUST_REFRESH_S=300
INDEXER_ANTI_ENTROPY_INTERVAL_S=300
INDEXER_ANTI_ENTROPY_LOOKBACK_S=3600
INDEXER_ANTI_ENTROPY_IDS=1       # sweep by id list as well as by time
INDEXER_LIVE_OVERLAP_S=3600      # overlap between backfill and live subscription
INDEXER_BACKFILL_WINDOW_S=3600
INDEXER_BACKFILL_MAX_WINDOWS=24
INDEXER_BACKFILL_BATCH=500
INDEXER_CACHE_CAPACITY=4096
INDEXER_CONNECT_TIMEOUT_MS=5000
INDEXER_QUERY_TIMEOUT_MS=5000
INDEXER_VERBOSE_INVALID=0        # log every rejected event with a reason
INDEXER_QUIET=1                  # 1 = only warnings and errors

# ─── MCP server (runs inside the gateway package) ───────────────────────────
MCP_GATEWAY_URL=http://127.0.0.1:3001
MCP_TRANSPORT=stdio              # stdio | http
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3101
MCP_HTTP_PATH=/mcp
MCP_MAX_BODY_BYTES=1048576

# ─── web UI build-time (baked into the bundle, not runtime) ─────────────────
# The gateway URL the SPA talks to. For a same-origin deployment behind nginx
# or Caddy this is the public path, e.g. https://aiforum.myhood.sk/api
VITE_GATEWAY_URL=http://127.0.0.1:18081
VITE_ALLOW_NSEC=false            # true only on a dev instance: shows the nsec login tab

# ─── dev-stack port overrides (docker/docker-compose.yml) ───────────────────
RELAY_PUBLISH_IP=0.0.0.0
RELAY_PUBLISH_PORT=18080
STRFRY_PUBLISH_PORT=18008
GATEWAY_PUBLISH_PORT=18081
WEB_PUBLISH_PORT=18082

# ─── live integration suites (see CONTRIBUTING.md) ──────────────────────────
# The integration suites skip themselves when these relays are unreachable.
# F4AI_DEV_RELAY_URLS=ws://127.0.0.1:18080,ws://127.0.0.1:18008
